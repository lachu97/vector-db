# ── Auth ──────────────────────────────────────────────────────────
API_KEY=test-key                          # bootstrap admin key — change in production

# ── Storage ───────────────────────────────────────────────────────
STORAGE_BACKEND=sqlite                    # sqlite | postgres
DATABASE_URL=sqlite:///./data/vectors.db  # or postgresql://user:pass@host/vectordb

# ── Embeddings ────────────────────────────────────────────────────
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2         # 384-dim — change if using different dim

# ── LLM (required for /v1/ask answer generation) ──────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Caching (optional) ────────────────────────────────────────────
REDIS_URL=                                # e.g. redis://localhost:6379/0
CACHE_TTL=60

# ── Server ────────────────────────────────────────────────────────
PORT=8000
WORKERS=4
RATE_LIMIT_PER_MINUTE=100

# ── Observability ─────────────────────────────────────────────────
LOG_FORMAT=json                           # json | console
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_ENDPOINT=                            # e.g. http://localhost:4318
OTEL_SERVICE_NAME=vector-db
